{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: app.py",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Train model",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": [
        "--data-dir", "data/plantvillage",
        "--epochs", "3",
        "--batch-size", "16",
        "--pretrained"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
